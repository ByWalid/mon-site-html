<!DOCTYPE html>

<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>RISE UP — Discipline. Bien-être. Force.</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Grotesk:wght@300;400;500;700&family=Italiana&display=swap" rel="stylesheet">
<style>
  :root {
    --black: #0a0a0a;
    --white: #f5f0e8;
    --cream: #ede8dd;
    --green: #2d6a4f;
    --green-light: #52b788;
    --green-neon: #74d7a3;
    --gold: #c9a84c;
    --red: #e63946;
    --gray: #3a3a3a;
    --gray-light: #888;
  }

- { margin: 0; padding: 0; box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
background: var(–black);
color: var(–white);
font-family: ‘Space Grotesk’, sans-serif;
overflow-x: hidden;
cursor: none;
}

/* Custom cursor */
.cursor {
width: 12px; height: 12px;
background: var(–green-neon);
border-radius: 50%;
position: fixed;
pointer-events: none;
z-index: 9999;
transition: transform 0.15s ease, width 0.2s, height 0.2s;
mix-blend-mode: difference;
}
.cursor-trail {
width: 32px; height: 32px;
border: 1px solid var(–green-neon);
border-radius: 50%;
position: fixed;
pointer-events: none;
z-index: 9998;
transition: all 0.08s linear;
mix-blend-mode: difference;
}

/* NOISE OVERLAY */
body::before {
content: ‘’;
position: fixed;
inset: 0;
background-image: url(“data:image/svg+xml,%3Csvg viewBox=‘0 0 256 256’ xmlns=‘http://www.w3.org/2000/svg’%3E%3Cfilter id=‘noise’%3E%3CfeTurbulence type=‘fractalNoise’ baseFrequency=‘0.9’ numOctaves=‘4’ stitchTiles=‘stitch’/%3E%3C/filter%3E%3Crect width=‘100%25’ height=‘100%25’ filter=‘url(%23noise)’ opacity=‘0.04’/%3E%3C/svg%3E”);
pointer-events: none;
z-index: 9000;
opacity: 0.4;
}

/* NAV */
nav {
position: fixed;
top: 0; left: 0; right: 0;
z-index: 1000;
display: flex;
justify-content: space-between;
align-items: center;
padding: 20px 60px;
background: transparent;
transition: background 0.4s;
}
nav.scrolled {
background: rgba(10,10,10,0.95);
backdrop-filter: blur(10px);
border-bottom: 1px solid rgba(82,183,136,0.2);
}
.nav-logo {
font-family: ‘Bebas Neue’, cursive;
font-size: 2rem;
letter-spacing: 4px;
color: var(–green-neon);
text-decoration: none;
}
.nav-links {
display: flex;
gap: 40px;
list-style: none;
}
.nav-links a {
color: var(–white);
text-decoration: none;
font-size: 0.8rem;
letter-spacing: 2px;
text-transform: uppercase;
opacity: 0.7;
transition: opacity 0.2s, color 0.2s;
}
.nav-links a:hover { opacity: 1; color: var(–green-neon); }
.nav-cta {
background: var(–green);
color: var(–white) !important;
padding: 10px 24px;
border-radius: 2px;
opacity: 1 !important;
transition: background 0.2s !important;
}
.nav-cta:hover { background: var(–green-light) !important; }

/* HERO */
#hero {
height: 100vh;
position: relative;
display: flex;
align-items: center;
justify-content: center;
overflow: hidden;
}
.hero-bg {
position: absolute;
inset: 0;
background: radial-gradient(ellipse 80% 60% at 50% 40%, rgba(45,106,79,0.25) 0%, transparent 70%),
radial-gradient(ellipse 40% 40% at 80% 80%, rgba(116,215,163,0.08) 0%, transparent 60%);
}
.hero-lines {
position: absolute;
inset: 0;
background-image: repeating-linear-gradient(
90deg,
rgba(255,255,255,0.015) 0px,
rgba(255,255,255,0.015) 1px,
transparent 1px,
transparent 80px
);
}
.hero-content {
text-align: center;
z-index: 2;
padding: 0 20px;
}
.hero-eyebrow {
font-size: 0.75rem;
letter-spacing: 6px;
text-transform: uppercase;
color: var(–green-neon);
margin-bottom: 24px;
opacity: 0;
animation: fadeUp 0.8s 0.3s forwards;
}
.hero-title {
font-family: ‘Bebas Neue’, cursive;
font-size: clamp(6rem, 18vw, 16rem);
line-height: 0.85;
letter-spacing: -2px;
color: var(–white);
opacity: 0;
animation: fadeUp 0.9s 0.5s forwards;
position: relative;
}
.hero-title span {
color: var(–green-neon);
display: block;
}
.hero-sub {
font-size: clamp(1rem, 2vw, 1.3rem);
color: var(–gray-light);
margin-top: 24px;
max-width: 500px;
margin-left: auto;
margin-right: auto;
line-height: 1.7;
opacity: 0;
animation: fadeUp 0.9s 0.7s forwards;
}
.hero-btns {
margin-top: 48px;
display: flex;
gap: 16px;
justify-content: center;
flex-wrap: wrap;
opacity: 0;
animation: fadeUp 0.9s 0.9s forwards;
}
.btn-primary {
background: var(–green-neon);
color: var(–black);
padding: 16px 40px;
font-weight: 700;
letter-spacing: 2px;
text-transform: uppercase;
font-size: 0.85rem;
text-decoration: none;
border-radius: 2px;
transition: transform 0.2s, box-shadow 0.2s;
display: inline-block;
}
.btn-primary:hover {
transform: translateY(-2px);
box-shadow: 0 8px 32px rgba(116,215,163,0.3);
}
.btn-outline {
border: 1px solid rgba(245,240,232,0.3);
color: var(–white);
padding: 16px 40px;
font-weight: 500;
letter-spacing: 2px;
text-transform: uppercase;
font-size: 0.85rem;
text-decoration: none;
border-radius: 2px;
transition: border-color 0.2s, background 0.2s;
display: inline-block;
}
.btn-outline:hover { border-color: var(–green-neon); background: rgba(116,215,163,0.05); }

.scroll-indicator {
position: absolute;
bottom: 40px;
left: 50%;
transform: translateX(-50%);
display: flex;
flex-direction: column;
align-items: center;
gap: 8px;
opacity: 0;
animation: fadeUp 1s 1.5s forwards;
}
.scroll-indicator span {
font-size: 0.65rem;
letter-spacing: 4px;
text-transform: uppercase;
color: var(–gray-light);
}
.scroll-line {
width: 1px;
height: 50px;
background: linear-gradient(to bottom, var(–green-neon), transparent);
animation: scrollPulse 2s infinite;
}

/* MARQUEE */
.marquee-section {
border-top: 1px solid rgba(255,255,255,0.07);
border-bottom: 1px solid rgba(255,255,255,0.07);
overflow: hidden;
padding: 20px 0;
background: var(–green);
}
.marquee-track {
display: flex;
gap: 60px;
animation: marquee 20s linear infinite;
white-space: nowrap;
}
.marquee-item {
font-family: ‘Bebas Neue’, cursive;
font-size: 1.5rem;
letter-spacing: 4px;
color: rgba(245,240,232,0.9);
display: flex;
align-items: center;
gap: 24px;
flex-shrink: 0;
}
.marquee-dot { color: var(–green-neon); font-size: 0.6rem; }

/* MANIFESTE */
#manifeste {
padding: 120px 60px;
max-width: 1200px;
margin: 0 auto;
}
.section-tag {
font-size: 0.7rem;
letter-spacing: 5px;
text-transform: uppercase;
color: var(–green-neon);
margin-bottom: 32px;
display: flex;
align-items: center;
gap: 12px;
}
.section-tag::before {
content: ‘’;
width: 30px;
height: 1px;
background: var(–green-neon);
}
.manifeste-grid {
display: grid;
grid-template-columns: 1fr 1fr;
gap: 80px;
align-items: start;
}
.manifeste-left h2 {
font-family: ‘Bebas Neue’, cursive;
font-size: clamp(3rem, 6vw, 5.5rem);
line-height: 0.9;
letter-spacing: 2px;
margin-bottom: 40px;
}
.manifeste-left h2 em {
color: var(–green-neon);
font-style: normal;
display: block;
}
.stat-row {
display: flex;
gap: 48px;
margin-top: 48px;
}
.stat { }
.stat-number {
font-family: ‘Bebas Neue’, cursive;
font-size: 3.5rem;
color: var(–green-neon);
line-height: 1;
}
.stat-label {
font-size: 0.75rem;
color: var(–gray-light);
letter-spacing: 1px;
margin-top: 4px;
}
.manifeste-right p {
font-size: 1.1rem;
line-height: 1.9;
color: rgba(245,240,232,0.7);
margin-bottom: 24px;
}
.manifeste-right p strong {
color: var(–white);
font-weight: 600;
}
.values-list {
margin-top: 40px;
display: flex;
flex-direction: column;
gap: 16px;
}
.value-item {
display: flex;
align-items: center;
gap: 16px;
padding: 16px 20px;
border: 1px solid rgba(255,255,255,0.06);
border-radius: 4px;
background: rgba(255,255,255,0.02);
transition: border-color 0.3s, background 0.3s;
}
.value-item:hover {
border-color: rgba(116,215,163,0.3);
background: rgba(116,215,163,0.04);
}
.value-icon {
font-size: 1.4rem;
min-width: 36px;
}
.value-text h4 {
font-size: 0.9rem;
font-weight: 600;
margin-bottom: 2px;
}
.value-text p {
font-size: 0.78rem;
color: var(–gray-light);
margin: 0;
line-height: 1.5;
}

/* PILLARS */
#pillars {
padding: 100px 60px;
background: rgba(255,255,255,0.02);
border-top: 1px solid rgba(255,255,255,0.05);
border-bottom: 1px solid rgba(255,255,255,0.05);
}
.pillars-header {
text-align: center;
margin-bottom: 80px;
}
.pillars-header h2 {
font-family: ‘Bebas Neue’, cursive;
font-size: clamp(2.5rem, 5vw, 4.5rem);
letter-spacing: 3px;
}
.pillars-grid {
display: grid;
grid-template-columns: repeat(3, 1fr);
gap: 2px;
max-width: 1200px;
margin: 0 auto;
}
.pillar-card {
padding: 60px 40px;
border: 1px solid rgba(255,255,255,0.06);
position: relative;
overflow: hidden;
transition: background 0.4s;
background: var(–black);
}
.pillar-card:hover { background: rgba(45,106,79,0.08); }
.pillar-card::before {
content: ‘’;
position: absolute;
top: 0; left: 0; right: 0;
height: 2px;
background: var(–green-neon);
transform: scaleX(0);
transform-origin: left;
transition: transform 0.4s;
}
.pillar-card:hover::before { transform: scaleX(1); }
.pillar-num {
font-family: ‘Bebas Neue’, cursive;
font-size: 4rem;
color: rgba(116,215,163,0.12);
line-height: 1;
margin-bottom: 16px;
}
.pillar-icon { font-size: 2rem; margin-bottom: 20px; }
.pillar-title {
font-family: ‘Bebas Neue’, cursive;
font-size: 1.8rem;
letter-spacing: 2px;
margin-bottom: 16px;
color: var(–white);
}
.pillar-desc {
font-size: 0.88rem;
line-height: 1.8;
color: var(–gray-light);
}

/* PRODUCTS */
#produits {
padding: 120px 60px;
max-width: 1400px;
margin: 0 auto;
}
.products-header {
display: flex;
justify-content: space-between;
align-items: flex-end;
margin-bottom: 64px;
}
.products-header h2 {
font-family: ‘Bebas Neue’, cursive;
font-size: clamp(3rem, 6vw, 5rem);
letter-spacing: 2px;
line-height: 0.9;
}
.products-header h2 span { color: var(–green-neon); }
.products-header p {
max-width: 300px;
color: var(–gray-light);
font-size: 0.88rem;
line-height: 1.7;
text-align: right;
}

/* PRODUCT TABS */
.product-tabs {
display: flex;
gap: 4px;
margin-bottom: 48px;
border-bottom: 1px solid rgba(255,255,255,0.08);
padding-bottom: 0;
}
.tab-btn {
padding: 12px 28px;
background: none;
border: none;
color: var(–gray-light);
font-family: ‘Space Grotesk’, sans-serif;
font-size: 0.8rem;
letter-spacing: 2px;
text-transform: uppercase;
cursor: pointer;
transition: color 0.2s;
border-bottom: 2px solid transparent;
margin-bottom: -1px;
}
.tab-btn.active {
color: var(–green-neon);
border-bottom-color: var(–green-neon);
}
.tab-btn:hover:not(.active) { color: var(–white); }

.product-grid {
display: grid;
grid-template-columns: repeat(4, 1fr);
gap: 20px;
}
.product-card {
background: rgba(255,255,255,0.025);
border: 1px solid rgba(255,255,255,0.06);
border-radius: 4px;
overflow: hidden;
transition: transform 0.3s, border-color 0.3s;
position: relative;
}
.product-card:hover {
transform: translateY(-6px);
border-color: rgba(116,215,163,0.3);
}
.product-visual {
height: 200px;
display: flex;
align-items: center;
justify-content: center;
font-size: 4rem;
position: relative;
overflow: hidden;
}
.product-visual::before {
content: ‘’;
position: absolute;
inset: 0;
opacity: 0.15;
}
.card-wellness .product-visual { background: linear-gradient(135deg, #1a3a2a, #2d6a4f); }
.card-wellness .product-visual::before { background: radial-gradient(circle at 50% 50%, var(–green-light), transparent); }
.card-protein .product-visual { background: linear-gradient(135deg, #1a2a3a, #2d4a6a); }
.card-protein .product-visual::before { background: radial-gradient(circle at 50% 50%, #52a0b7, transparent); }
.card-badge {
position: absolute;
top: 12px; right: 12px;
background: var(–green-neon);
color: var(–black);
font-size: 0.6rem;
font-weight: 700;
letter-spacing: 2px;
padding: 4px 10px;
border-radius: 2px;
text-transform: uppercase;
}
.product-info {
padding: 24px;
}
.product-category {
font-size: 0.65rem;
letter-spacing: 3px;
text-transform: uppercase;
color: var(–green-light);
margin-bottom: 8px;
}
.product-name {
font-weight: 600;
font-size: 1rem;
margin-bottom: 8px;
color: var(–white);
}
.product-desc {
font-size: 0.78rem;
color: var(–gray-light);
line-height: 1.6;
margin-bottom: 16px;
}
.product-footer {
display: flex;
justify-content: space-between;
align-items: center;
}
.product-price {
font-family: ‘Bebas Neue’, cursive;
font-size: 1.5rem;
color: var(–green-neon);
}
.product-price small {
font-family: ‘Space Grotesk’, sans-serif;
font-size: 0.7rem;
color: var(–gray-light);
display: block;
font-weight: 400;
line-height: 1;
margin-top: 2px;
}
.add-btn {
background: rgba(116,215,163,0.1);
border: 1px solid rgba(116,215,163,0.3);
color: var(–green-neon);
padding: 8px 16px;
font-size: 0.75rem;
font-family: ‘Space Grotesk’, sans-serif;
cursor: pointer;
letter-spacing: 1px;
border-radius: 2px;
transition: background 0.2s, border-color 0.2s;
}
.add-btn:hover { background: rgba(116,215,163,0.2); border-color: var(–green-neon); }

/* TABS CONTENT */
.tab-panel { display: none; }
.tab-panel.active { display: block; }

/* DISCIPLINE SECTION */
#discipline {
padding: 120px 60px;
background: var(–green);
position: relative;
overflow: hidden;
}
#discipline::before {
content: ‘DISCIPLINE’;
position: absolute;
font-family: ‘Bebas Neue’, cursive;
font-size: 20vw;
color: rgba(0,0,0,0.15);
top: 50%;
left: 50%;
transform: translate(-50%, -50%);
pointer-events: none;
white-space: nowrap;
}
.discipline-grid {
display: grid;
grid-template-columns: 1fr 1fr;
gap: 80px;
align-items: center;
max-width: 1200px;
margin: 0 auto;
position: relative;
z-index: 2;
}
.discipline-left h2 {
font-family: ‘Bebas Neue’, cursive;
font-size: clamp(3rem, 6vw, 5.5rem);
line-height: 0.9;
letter-spacing: 2px;
color: var(–cream);
margin-bottom: 32px;
}
.discipline-left p {
color: rgba(237,232,221,0.75);
font-size: 1.05rem;
line-height: 1.8;
margin-bottom: 40px;
}
.routine-cards {
display: flex;
flex-direction: column;
gap: 16px;
}
.routine-card {
background: rgba(0,0,0,0.2);
border: 1px solid rgba(255,255,255,0.1);
border-radius: 4px;
padding: 20px 24px;
display: flex;
gap: 20px;
align-items: flex-start;
backdrop-filter: blur(10px);
transition: background 0.3s;
}
.routine-card:hover { background: rgba(0,0,0,0.35); }
.routine-time {
font-family: ‘Bebas Neue’, cursive;
font-size: 1.3rem;
color: var(–green-neon);
min-width: 60px;
}
.routine-content h4 {
font-size: 0.9rem;
font-weight: 600;
color: var(–cream);
margin-bottom: 4px;
}
.routine-content p {
font-size: 0.78rem;
color: rgba(237,232,221,0.6);
line-height: 1.5;
margin: 0;
}

/* QUOTES */
#quotes {
padding: 100px 60px;
text-align: center;
border-top: 1px solid rgba(255,255,255,0.05);
}
.quote-container {
max-width: 900px;
margin: 0 auto;
}
.quote-text {
font-family: ‘Italiana’, serif;
font-size: clamp(1.8rem, 4vw, 3.2rem);
line-height: 1.3;
color: var(–white);
margin-bottom: 32px;
position: relative;
}
.quote-text::before {
content: ‘”’;
font-size: 8rem;
color: var(–green-neon);
opacity: 0.2;
position: absolute;
top: -30px;
left: -30px;
font-family: ‘Italiana’, serif;
line-height: 1;
}
.quote-author {
font-size: 0.75rem;
letter-spacing: 4px;
text-transform: uppercase;
color: var(–green-neon);
}
.quote-dots {
display: flex;
gap: 8px;
justify-content: center;
margin-top: 40px;
}
.quote-dot {
width: 8px; height: 8px;
border-radius: 50%;
background: rgba(255,255,255,0.2);
cursor: pointer;
transition: background 0.2s, transform 0.2s;
}
.quote-dot.active { background: var(–green-neon); transform: scale(1.3); }

/* NEWSLETTER */
#newsletter {
padding: 100px 60px;
background: rgba(45,106,79,0.08);
border-top: 1px solid rgba(45,106,79,0.2);
border-bottom: 1px solid rgba(45,106,79,0.2);
text-align: center;
}
.newsletter-content {
max-width: 600px;
margin: 0 auto;
}
.newsletter-content h2 {
font-family: ‘Bebas Neue’, cursive;
font-size: clamp(2.5rem, 5vw, 4.5rem);
letter-spacing: 2px;
margin-bottom: 16px;
}
.newsletter-content h2 span { color: var(–green-neon); }
.newsletter-content p {
color: var(–gray-light);
font-size: 0.95rem;
line-height: 1.7;
margin-bottom: 40px;
}
.newsletter-form {
display: flex;
gap: 8px;
max-width: 480px;
margin: 0 auto;
}
.newsletter-input {
flex: 1;
background: rgba(255,255,255,0.05);
border: 1px solid rgba(255,255,255,0.12);
color: var(–white);
padding: 16px 20px;
font-family: ‘Space Grotesk’, sans-serif;
font-size: 0.9rem;
border-radius: 2px;
outline: none;
transition: border-color 0.2s;
}
.newsletter-input:focus { border-color: var(–green-neon); }
.newsletter-input::placeholder { color: var(–gray-light); }

/* FOOTER */
footer {
padding: 80px 60px 40px;
border-top: 1px solid rgba(255,255,255,0.06);
}
.footer-grid {
display: grid;
grid-template-columns: 2fr 1fr 1fr 1fr;
gap: 60px;
margin-bottom: 60px;
}
.footer-brand p {
color: var(–gray-light);
font-size: 0.85rem;
line-height: 1.7;
margin-top: 16px;
max-width: 260px;
}
.footer-logo {
font-family: ‘Bebas Neue’, cursive;
font-size: 2.5rem;
letter-spacing: 4px;
color: var(–green-neon);
}
.footer-col h4 {
font-size: 0.7rem;
letter-spacing: 4px;
text-transform: uppercase;
color: var(–white);
margin-bottom: 20px;
}
.footer-col ul { list-style: none; }
.footer-col ul li {
margin-bottom: 12px;
}
.footer-col ul li a {
color: var(–gray-light);
text-decoration: none;
font-size: 0.85rem;
transition: color 0.2s;
}
.footer-col ul li a:hover { color: var(–green-neon); }
.footer-bottom {
display: flex;
justify-content: space-between;
align-items: center;
border-top: 1px solid rgba(255,255,255,0.06);
padding-top: 32px;
}
.footer-bottom p {
color: var(–gray-light);
font-size: 0.78rem;
}
.social-links {
display: flex;
gap: 20px;
}
.social-link {
width: 36px; height: 36px;
border: 1px solid rgba(255,255,255,0.12);
border-radius: 50%;
display: flex;
align-items: center;
justify-content: center;
color: var(–gray-light);
text-decoration: none;
font-size: 0.8rem;
transition: border-color 0.2s, color 0.2s;
}
.social-link:hover { border-color: var(–green-neon); color: var(–green-neon); }

/* ANIMATIONS */
@keyframes fadeUp {
from { opacity: 0; transform: translateY(30px); }
to { opacity: 1; transform: translateY(0); }
}
@keyframes marquee {
from { transform: translateX(0); }
to { transform: translateX(-50%); }
}
@keyframes scrollPulse {
0%, 100% { opacity: 1; transform: scaleY(1); }
50% { opacity: 0.4; transform: scaleY(0.7); }
}

.reveal {
opacity: 0;
transform: translateY(40px);
transition: opacity 0.7s ease, transform 0.7s ease;
}
