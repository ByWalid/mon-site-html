    tx += (mx - tx) * 0.15;
    ty += (my - ty) * 0.15;
    trail.style.left = tx - 16 + 'px';
    trail.style.top = ty - 16 + 'px';
  }, 16);

  // NAV SCROLL
  const navbar = document.getElementById('navbar');
  window.addEventListener('scroll', () => {
    navbar.classList.toggle('scrolled', window.scrollY > 60);
  });

  // REVEAL ON SCROLL
  const observer = new IntersectionObserver(entries => {
    entries.forEach((e, i) => {
      if (e.isIntersecting) {
        setTimeout(() => e.target.classList.add('visible'), i * 80);
      }
    });
  }, { threshold: 0.1 });
  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

  // TABS
  function switchTab(tab) {
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
    event.target.classList.add('active');
    document.getElementById('tab-' + tab).classList.add('active');
    document.querySelectorAll('#tab-' + tab + ' .reveal').forEach(el => {
      el.classList.remove('visible');
      setTimeout(() => el.classList.add('visible'), 100);
    });
  }

  // TOAST
  function showToast(msg) {
    const t = document.getElementById('toast');
    document.getElementById('toastMsg').textContent = msg;
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 3000);
  }

  // ADD TO CART
  function addToCart(name) {
    showToast(`✓ ${name} ajouté au panier !`);
  }

  // NEWSLETTER
  function subscribe() {
    const email = document.getElementById('emailInput').value;
    if (!email || !email.includes('@')) {
      showToast('Entre un email valide 🙏');
      return;
    }
    document.getElementById('emailInput').value = '';
    showToast('🎉 Bienvenue dans le mouvement RISE UP !');
  }

  // QUOTES
  const quotes = [
    { text: 'La discipline est le pont entre les objectifs et les accomplissements.', author: '— Jim Rohn' },
    { text: 'Tu n\'as pas à être parfait. Tu as juste à te lever chaque matin et décider de te battre.', author: '— Rise Up' },
    { text: 'Le succès n\'est pas final, l\'échec n\'est pas fatal : c\'est le courage de continuer qui compte.', author: '— Winston Churchill' },
    { text: 'Prends soin de ton corps. C\'est le seul endroit où tu sois obligé de vivre.', author: '— Jim Rohn' },
  ];
  let currentQuote = 0;

  function setQuote(i) {
    currentQuote = i;
    const qt = document.getElementById('quoteText');
    const qa = document.getElementById('quoteAuthor');
    qt.style.opacity = 0;
    qa.style.opacity = 0;
    setTimeout(() => {
      qt.textContent = quotes[i].text;
      qa.textContent = quotes[i].author;
      qt.style.opacity = 1;
      qa.style.opacity = 1;
    }, 300);
    document.querySelectorAll('.quote-dot').forEach((d, j) => {
      d.classList.toggle('active', j === i);
    });
  }
  setInterval(() => setQuote((currentQuote + 1) % quotes.length), 5000);

  // Smooth opacity for quotes
  document.getElementById('quoteText').style.transition = 'opacity 0.4s';
  document.getElementById('quoteAuthor').style.transition = 'opacity 0.4s';

  // Initial reveal for hero elements (already animated via CSS)
  // Trigger tab-soin reveals on load
  setTimeout(() => {
    document.querySelectorAll('#tab-soin .reveal').forEach(el => el.classList.add('visible'));
  }, 300);
</script>

</body>
</html>